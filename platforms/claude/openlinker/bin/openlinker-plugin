#!/bin/sh
set -eu

plugin_root=${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}
if [ -z "$plugin_root" ]; then
  plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
fi

required_capability=plugin.serve
if [ "${1:-}" = plugin ] && { [ "${2:-}" = browser-serve ] || [ "${2:-}" = browser-proxy ]; }; then
  required_capability=plugin.browser.serve
fi
host_path=$(node "$plugin_root/scripts/resolve-plugin-host.mjs" --require "$required_capability")
exec "$host_path" "$@"
