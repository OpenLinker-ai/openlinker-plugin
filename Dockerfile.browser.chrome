# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

# Operator-only local build. OpenLinker release workflows must not publish this
# image unless the independent redistribution and retention gates are approved.
ARG OPENLINKER_BROWSER_BASE
FROM ${OPENLINKER_BROWSER_BASE}

ARG OPENLINKER_BROWSER_BASE
USER root
ARG TARGETARCH
ARG OPENLINKER_CHROME_ARTIFACT=chrome.tar
ARG OPENLINKER_CHROME_LOCK=chrome.lock.json
ARG OPENLINKER_BROWSER_DISTRIBUTION
ARG OPENLINKER_BROWSER_VERSION
ARG OPENLINKER_BROWSER_PROFILE_GENERATION
COPY --chown=root:root --chmod=0444 ${OPENLINKER_CHROME_ARTIFACT} /tmp/operator-chrome/chrome.tar
COPY --chown=root:root --chmod=0444 ${OPENLINKER_CHROME_LOCK} /tmp/operator-chrome/chrome.lock.json
COPY --chown=root:root --chmod=0444 test/browser-image/verify-chrome-lock.mjs /tmp/operator-chrome/verify-chrome-lock.mjs
RUN base_digest="${OPENLINKER_BROWSER_BASE##*@sha256:}" \
 && test "${OPENLINKER_BROWSER_BASE}" != "${base_digest}" \
 && test "${#base_digest}" -eq 64 \
 && case "${base_digest}" in *[!0-9a-f]*) exit 1 ;; esac \
 && test "${TARGETARCH}" = amd64 \
 && node /tmp/operator-chrome/verify-chrome-lock.mjs \
      /tmp/operator-chrome/chrome.lock.json \
      /tmp/operator-chrome/chrome.tar \
      "${OPENLINKER_BROWSER_DISTRIBUTION}" \
      "${OPENLINKER_BROWSER_VERSION}" \
 && expr "${OPENLINKER_BROWSER_PROFILE_GENERATION}" : '[1-9][0-9]*$' >/dev/null \
 && tar -tf /tmp/operator-chrome/chrome.tar \
      | awk 'BEGIN { ok=1 } !/^chrome\\// || /(^|\\/)\\.\\.($|\\/)/ || /^\\// { ok=0 } END { exit ok ? 0 : 1 }' \
 && test -z "$(tar -tvf /tmp/operator-chrome/chrome.tar | awk 'substr($1,1,1) != "-" && substr($1,1,1) != "d" { print }')" \
 && install -d -o root -g root -m 0555 /opt/google \
 && tar -xf /tmp/operator-chrome/chrome.tar -C /opt/google --no-same-owner --no-same-permissions \
 && test -x /opt/google/chrome/chrome \
 && test "$(/opt/google/chrome/chrome --version | grep -oE '[0-9]+(\\.[0-9]+){1,3}' | tail -n 1)" = "${OPENLINKER_BROWSER_VERSION}" \
 && chown -R root:root /opt/google/chrome \
 && chmod -R a-w /opt/google/chrome \
 && rm -rf /tmp/operator-chrome
ENV OPENLINKER_BROWSER_ENGINE=chrome \
    OPENLINKER_BROWSER_DISTRIBUTION=${OPENLINKER_BROWSER_DISTRIBUTION} \
    OPENLINKER_BROWSER_VERSION=${OPENLINKER_BROWSER_VERSION} \
    OPENLINKER_BROWSER_PROFILE_GENERATION=${OPENLINKER_BROWSER_PROFILE_GENERATION}
USER 10001:10001
LABEL org.opencontainers.image.title="Operator-built OpenLinker Chrome Browser Runtime" \
      org.opencontainers.image.description="Local amd64-only locked Chrome channel extension of OpenLinker Browser Runtime" \
      org.opencontainers.image.openlinker.redistribution="not-approved"
